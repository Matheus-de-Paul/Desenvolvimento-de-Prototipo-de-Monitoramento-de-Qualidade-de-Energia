#include "thingProperties.h"
#include <SPI.h>
#include <LoRa.h>

// ===================== PINOS DO LoRa =====================
const int LORA_SCK  = 18;
const int LORA_MISO = 19;
const int LORA_MOSI = 23;
const int LORA_SS   = 5;
const int LORA_RST  = 14;
const int LORA_DIO0 = 26;

// ===================== RADIO (igual ao transmissor) =====================
const long    LORA_FREQ      = 915E6;
const int     LORA_SF        = 7;
const long    LORA_BANDA     = 125E3;
const uint8_t LORA_SYNC_WORD = 0xF3;

// ===================== REFERENCIAS (PRODIST Modulo 8) =====================
const float V_MIN_ADEQUADA = 117.0;
const float V_MAX_ADEQUADA = 133.0;
const float F_MIN = 59.9, F_MAX = 60.1;
const float FP_MIN = 0.92;
const float THDV_MAX = 10.0;

const int N_HARMONICOS = 10;

// ===================== PACOTE (igual ao do transmissor) =====================
struct __attribute__((packed)) PacoteQEE {
  uint16_t contador;
  uint8_t  flags;           // bit0: tem tensao | bit1: tem corrente | bit2: partida | bit3: trifasico
  float    frequencia;
  float    vrms;
  float    irms;
  float    p;
  float    q;
  float    s;
  float    fp;
  float    defasagem;
  float    thdV;
  float    thdI;
  uint16_t harmV[N_HARMONICOS - 1];  // H2..H10 em % x 100
  uint16_t harmI[N_HARMONICOS - 1];
};

long recebidos = 0;
long perdidos = 0;
long ultimoContador = -1;
unsigned long ultimoPacoteMs = 0;

const char *ok(bool cond) { return cond ? "OK" : "FORA"; }

// ---------------------------------------------------------------
// Envia os valores recebidos para as variaveis do Arduino Cloud
// ---------------------------------------------------------------
void publicarNaNuvem(const PacoteQEE &pk) {
  bool temV = pk.flags & 1;
  bool temI = pk.flags & 2;

  if (temV) {
    Tensao     = pk.vrms;
    Frequencia = pk.frequencia;
    THD        = pk.thdV;
  }
  if (temI) {
    Corrente = pk.irms;
  }
  if (temV && temI) {
    FdP = pk.fp;
  }
}

void imprimirPacote(const PacoteQEE &pk, int rssi, float snr) {
  bool temV = pk.flags & 1;
  bool temI = pk.flags & 2;
  bool partida = pk.flags & 4;
  bool tri = pk.flags & 8;

  Serial.println();
  Serial.println("================ DADOS RECEBIDOS (LoRa) ================");
  Serial.printf("Pacote: %u | RSSI: %d dBm | SNR: %.1f dB | recebidos: %ld | perdidos: %ld\n",
                pk.contador, rssi, snr, recebidos, perdidos);
  if (partida) Serial.println(">>> Houve PARTIDA do motor neste intervalo (valores em transitorio)");

  if (temV) {
    Serial.printf("Frequencia:        %.2f Hz   [%s 59,9-60,1 Hz]\n", pk.frequencia,
                  ok(pk.frequencia >= F_MIN && pk.frequencia <= F_MAX));
    Serial.printf("Tensao RMS:        %.1f V    [%s 117-133 V]\n", pk.vrms,
                  ok(pk.vrms >= V_MIN_ADEQUADA && pk.vrms <= V_MAX_ADEQUADA));
  } else {
    Serial.println("Tensao:            -- (sem tensao)");
  }
  Serial.printf("Corrente RMS:      %.3f A\n", pk.irms);

  if (temV && temI) {
    const char *tipo = fabs(pk.defasagem) < 1.0 ? "resistivo" : (pk.defasagem > 0 ? "indutivo" : "capacitivo");
    Serial.printf("Potencias %s P = %.1f W | Q = %.1f var | S = %.1f VA\n",
                  tri ? "(total 3F):" : "(1 fase):  ", pk.p, pk.q, pk.s);
    Serial.printf("Fator de potencia: %.3f (%s)  [%s >= 0,92]\n", pk.fp, tipo, ok(pk.fp >= FP_MIN));
    Serial.printf("Defasagem V-I:     %.1f graus\n", pk.defasagem);
  }
  if (temV) Serial.printf("THD tensao:        %.2f %%   [%s <= 10 %%]\n", pk.thdV, ok(pk.thdV <= THDV_MAX));
  if (temI) Serial.printf("THD corrente:      %.2f %%\n", pk.thdI);

  Serial.println("--- harmonicos (% da fundamental) ---");
  Serial.println(" H    Freq     %V      %I");
  for (int k = 0; k < N_HARMONICOS - 1; k++) {
    Serial.printf("%2d  %4d Hz  %6.2f  %6.2f\n", k + 2, (k + 2) * 60,
                  pk.harmV[k] / 100.0, pk.harmI[k] / 100.0);
  }
}

// ===============================
// Setup
// ===============================
void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\n=== RECEPTOR LoRa + Arduino Cloud ===");

  // ---- LoRa ----
  SPI.begin(LORA_SCK, LORA_MISO, LORA_MOSI, LORA_SS);
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  while (!LoRa.begin(LORA_FREQ)) {
    Serial.println("ERRO: modulo LoRa nao encontrado. Confira 3V3, GND e os pinos SPI.");
    delay(2000);
  }
  LoRa.setSpreadingFactor(LORA_SF);
  LoRa.setSignalBandwidth(LORA_BANDA);
  LoRa.setSyncWord(LORA_SYNC_WORD);
  LoRa.enableCrc();
  Serial.printf("LoRa OK: %.0f MHz, SF%d. Aguardando pacotes de %u bytes...\n",
                LORA_FREQ / 1e6, LORA_SF, (unsigned)sizeof(PacoteQEE));

  // Defined in thingProperties.h
  initProperties();

  // Connect to Arduino IoT Cloud
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();

  ultimoPacoteMs = millis();
}

// ===============================
// Loop
// ===============================
void loop() {
  ArduinoCloud.update();

  int tamanho = LoRa.parsePacket();
  if (tamanho > 0) {
    int rssi = LoRa.packetRssi();
    float snr = LoRa.packetSnr();

    if (tamanho != (int)sizeof(PacoteQEE)) {
      Serial.printf("Pacote ignorado: %d bytes (esperado %u) | RSSI %d dBm\n",
                    tamanho, (unsigned)sizeof(PacoteQEE), rssi);
      while (LoRa.available()) LoRa.read();
      return;
    }

    PacoteQEE pk;
    uint8_t *dest = (uint8_t *)&pk;
    for (int n = 0; n < tamanho; n++) dest[n] = LoRa.read();

    // Conta pacotes perdidos pela sequencia do contador
    if (ultimoContador >= 0) {
      uint16_t esperado = (uint16_t)(ultimoContador + 1);
      if (pk.contador != esperado) perdidos += (uint16_t)(pk.contador - esperado);
    }
    ultimoContador = pk.contador;
    recebidos++;
    ultimoPacoteMs = millis();

    publicarNaNuvem(pk);
    imprimirPacote(pk, rssi, snr);
  }

  // Aviso se ficar muito tempo sem receber nada
  if (millis() - ultimoPacoteMs > 15000) {
    Serial.println("... nenhum pacote ha 15 s (transmissor ligado? mesma frequencia/SF/sync word?)");
    ultimoPacoteMs = millis();
  }
}

